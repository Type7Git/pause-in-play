{
  "appId": "au.com.type7.pauseinplay",
  "appName": "Lumenera",
  "webDir": "www",
  "server": {
    "url": "https://pause-in-play.lovable.app",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "*.lovable.app",
      "*.lumenera.com.au",
      "*.pauseinplay.com",
      "*.supabase.co",
      "lumenera.com.au",
      "pause-in-play.lovable.app",
      "pauseinplay.com"
    ]
  },
  "android": {
    "backgroundColor": "#FBF1F3",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#FBF1F3",
    "contentInset": "automatic"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "backgroundColor": "#FBF1F3",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "launchFadeOutDuration": 250
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DEFAULT",
      "backgroundColor": "#FBF1F3"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#A8486B"
    }
  }
}
